# Linear OAuth access token — from an OAuth app that has been granted access
# to the private team. See GUIDE.md for setup instructions.
LINEAR_ACCESS_TOKEN=lin_oauth_xxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Webhook signing secret — from the webhook configured on your OAuth app.
LINEAR_WEBHOOK_SECRET=your_webhook_signing_secret

# Port for the webhook server (default: 3000)
PORT=3000

# Optional: restrict to specific teams. Use team UUIDs (not team keys like "LEG").
# Comma-separated. Leave blank if your webhook is already scoped to the right team.
# TARGET_TEAM_IDS=a1b2c3d4-e5f6-7890-abcd-ef1234567890
