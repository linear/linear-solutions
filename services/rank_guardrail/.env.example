# Rank guardrail configuration. See README.md. Replace every placeholder except LINEAR_API_KEY.
# The team name must contain the word "test" (see README "Before you start").
TEST_TEAM_ID=REPLACE_WITH_TEST_TEAM_UUID
TEST_TEAM_ALLOWLIST=REPLACE_WITH_SAME_TEST_TEAM_UUID
PROTECTED_LABEL_ID=REPLACE_WITH_LABEL_UUID
# Leave this placeholder. Export LINEAR_API_KEY="Bearer <OAuth access token>" at runtime
# (README step 5) so the token is never written to disk; the environment overrides this file.
LINEAR_API_KEY=REPLACE_WITH_RUNTIME_OAUTH_TOKEN
# The webhook's signing secret, or a random value (openssl rand -hex 32) until you add a webhook.
WEBHOOK_SECRET=REPLACE_WITH_WEBHOOK_SIGNING_SECRET
# Only the exact lower-case value false permits rank mutations.
DRY_RUN=true
# Only the exact lower-case value true lets workspace owners/admins and owners of this exact
# team reorder protected issues (needs a working webhook). Anything else: every move is repaired.
ROLE_APPROVALS=false
# How long (0-60000 ms) unexplained drift waits for its webhook before repair when ROLE_APPROVALS=true.
APPROVAL_GRACE_MS=10000
STATE_DIR=.state
PORT=8787
