# Rank guardrail configuration. See README.md. Replace every placeholder except LINEAR_API_KEY.
# Teams to protect, as <team UUID>:<label UUID> pairs separated by commas (up to 20 teams,
# one protected label per team; several teams may use the same workspace label).
PROTECTED_TEAMS=REPLACE_WITH_TEAM_UUID:REPLACE_WITH_LABEL_UUID
# Leave this placeholder. Export LINEAR_API_KEY="Bearer <OAuth access token>" at runtime
# (README step 5) so the token is never written to disk; the environment overrides this file.
LINEAR_API_KEY=REPLACE_WITH_RUNTIME_OAUTH_TOKEN
# The webhook signing secret, or comma-separated secrets if you create one webhook per team.
# Use a random value (openssl rand -hex 32) until you add a webhook.
WEBHOOK_SECRET=REPLACE_WITH_WEBHOOK_SIGNING_SECRET
# Only the exact lower-case value false permits rank mutations.
DRY_RUN=true
# Only the exact lower-case value true lets workspace owners/admins and owners of the team being
# reordered approve protected reorders (needs a working webhook). Anything else: every move is repaired.
ROLE_APPROVALS=false
# How long (0-60000 ms) unexplained drift waits for its webhook before repair when ROLE_APPROVALS=true.
APPROVAL_GRACE_MS=10000
# Each team's state lives in STATE_DIR/teams/<team UUID>/.
STATE_DIR=.state
PORT=8787
