# Rank guardrail configuration. See README.md. Replace every placeholder.
# One <team-uuid>:<label-uuid> pair per protected team, comma-separated, for example
# PROTECTED_TEAMS=11111111-...:22222222-...,33333333-...:44444444-...
PROTECTED_TEAMS=REPLACE_WITH_TEAM_UUID:REPLACE_WITH_LABEL_UUID
# The OAuth app's API key (actor=app). A bare key is sent as "Bearer <key>".
LINEAR_API_KEY=REPLACE_WITH_OAUTH_APP_API_KEY
# The webhook's signing secret, or a random value (openssl rand -hex 32) until you add a webhook.
WEBHOOK_SECRET=REPLACE_WITH_WEBHOOK_SIGNING_SECRET
# Only the exact lower-case value false permits rank mutations.
DRY_RUN=true
# Only the exact lower-case value true lets workspace owners/admins and owners of the exact
# protected team reorder protected issues (needs a working webhook). Anything else: every move is repaired.
ROLE_APPROVALS=false
# How long (0-60000 ms) unexplained drift waits for its webhook before repair when ROLE_APPROVALS=true.
APPROVAL_GRACE_MS=10000
STATE_DIR=.state
PORT=8787
